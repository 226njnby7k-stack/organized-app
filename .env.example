# App mode. "TEST" runs a local offline demo (no backend). Leave unset/empty to
# run against a real API.
VITE_APP_MODE="TEST"

# M6: Firebase fully removed — the old VITE_FIREBASE_* config is gone.

# Self-hosted API base URL. Defaults to http://localhost:8000/ in dev; set this to
# your deployed API for a real/self-hosted instance (must end with a trailing /).
VITE_BACKEND_API=http://localhost:8000/

# M5.5: fully self-hosted mode. When 'true', onboarding drops the external
# sws2apps congregation directory: the admin types the congregation name directly
# (no directory search), and the post-creation setup prompts for the blank
# congregation number / Kingdom Hall address / circuit / meeting times. The API
# must be started with SELF_HOSTED=true to match. Default false = upstream.
VITE_SELF_HOSTED=false